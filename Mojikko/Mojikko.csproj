<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mojikko</RootNamespace>
    <AssemblyName>Mojikko</AssemblyName>
    <Product>Mojikko</Product>
    <AssemblyTitle>Mojikko — 文字コードをそろえる</AssemblyTitle>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- 外部の NuGet パッケージは使わない（文字コードの判別も自前） -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
